<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISSION NOTES (read before publishing):

      PACKAGE_USAGE_STATS  -> "usage access". Special permission; user grants it in
                              Settings, not via a normal dialog. Lets us read which app
                              is in the foreground. This is the MVP detection route and
                              carries LOWER Play Store review risk than AccessibilityService.

      SYSTEM_ALERT_WINDOW  -> "draw over other apps". Lets us paint the interrupt screen
                              on top of Instagram/etc. User grants via a Settings toggle.

      QUERY_ALL_PACKAGES   -> only needed if you later list ALL installed apps (the
                              "App Prioritizer" feature). It is a RESTRICTED permission:
                              you must file a Play Console declaration and have a core
                              purpose. For the MVP you do NOT need it — you only watch a
                              short user-chosen list of apps, so it is commented out. The
                              picker lists launchable apps via the <queries> intents below.

      FOREGROUND_SERVICE    -> keeps the detection service alive reliably.

      SDK GATING            -> minSdk is 26, but two of the declarations below only
                              exist on newer platforms: FOREGROUND_SERVICE_SPECIAL_USE
                              is API 34+, POST_NOTIFICATIONS is API 33+. They carry
                              android:minSdkVersion so older devices never see a
                              permission their platform cannot resolve. The matching
                              runtime branch is in AppWatchService.startForegroundCompat().
    -->

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" /> -->

    <!--
      PACKAGE VISIBILITY (Android 11 / API 30+).

      Since API 30 an app cannot see other installed packages unless it declares what it
      needs here. We declare two INTENTS, not a blanket permission:
        - MAIN + LAUNCHER  -> every app that has a home-screen icon, so the picker can
                              list them (AppsRepository.launchableApps).
        - VIEW https       -> which of those are browsers, for the "Browsing" group.

      This is the sanctioned alternative to QUERY_ALL_PACKAGES: an intent-scoped query is
      not a restricted permission and needs no Play Console declaration. Apps without a
      launcher icon stay invisible to us, which is fine — nobody opens those by reflex.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".IntentCoachApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntentCoach">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent activity used to render the interrupt screen as an overlay -->
        <activity
            android:name=".overlay.InterruptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.IntentCoach.Transparent" />

        <!--
          foregroundServiceType is only read by API 34+. Older platforms ignore the
          attribute entirely, which is why it is safe to leave declared at minSdk 26.
        -->
        <service
            android:name=".detection.AppWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Detects when an app the user chose comes to the foreground, to show a user-requested intention check-in, and measures how long it stays on screen. Data stays on device." />
        </service>

        <receiver
            android:name=".detection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
