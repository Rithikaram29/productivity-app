<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISSION NOTES (read before publishing):

      PACKAGE_USAGE_STATS  -> "usage access". Special permission; user grants it in
                              Settings, not via a normal dialog. Lets us read which app
                              is in the foreground. This is the MVP detection route and
                              carries LOWER Play Store review risk than AccessibilityService.

      SYSTEM_ALERT_WINDOW  -> "draw over other apps". Lets us paint the interrupt screen
                              on top of Instagram/etc. User grants via a Settings toggle.

      QUERY_ALL_PACKAGES   -> only needed if you later list ALL installed apps (the
                              "App Prioritizer" feature). It is a RESTRICTED permission:
                              you must file a Play Console declaration and have a core
                              purpose. For the MVP you do NOT need it — you only watch a
                              short user-chosen list of apps, so it is commented out.

      FOREGROUND_SERVICE    -> keeps the detection service alive reliably.

      SDK GATING            -> minSdk is 26, but two of the declarations below only
                              exist on newer platforms: FOREGROUND_SERVICE_SPECIAL_USE
                              is API 34+, POST_NOTIFICATIONS is API 33+. They carry
                              android:minSdkVersion so older devices never see a
                              permission their platform cannot resolve. The matching
                              runtime branch is in AppWatchService.startForegroundCompat().
    -->

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"
        xmlns:tools="http://schemas.android.com/tools" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" /> -->

    <!--
      PACKAGE VISIBILITY (Android 11 / API 30+).

      Since API 30 an app cannot see other installed packages unless it declares them
      here. Without this block getApplicationInfo() throws NameNotFoundException for
      apps that ARE installed, so the picker showed an empty list and every screen fell
      back to guessing names from the package string ("Frontpage" instead of "Reddit").

      Declaring specific packages is the sanctioned alternative to QUERY_ALL_PACKAGES —
      no Play Console declaration needed. Keep this list in sync with
      WatchedApps.CATALOG: an app missing here is invisible to us even when installed.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.twitter.android" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.snapchat.android" />
        <package android:name="com.instagram.barcelona" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.discord" />
        <package android:name="com.linkedin.android" />
        <package android:name="com.pinterest" />
        <package android:name="com.quora.android" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.spotify.music" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <package android:name="com.flipkart.android" />
    </queries>

    <application
        android:name=".IntentCoachApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IntentCoach">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent activity used to render the interrupt screen as an overlay -->
        <activity
            android:name=".overlay.InterruptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.IntentCoach.Transparent" />

        <!--
          foregroundServiceType is only read by API 34+. Older platforms ignore the
          attribute entirely, which is why it is safe to leave declared at minSdk 26.
        -->
        <service
            android:name=".detection.AppWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Monitors foreground app to show a mindfulness interrupt chosen by the user" />
        </service>

        <receiver
            android:name=".detection.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
